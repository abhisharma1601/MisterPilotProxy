# Store backend: memory (default, no disk writes) | file | redis | database
PII_STORE_BACKEND=

PROXY_HMAC_KEY=
APP_ENV=dev

# AWS credentials (for Secrets Manager) — local dev only.
# In production, attach an IAM role to the instance/task instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# MisterPilot microservice (wallet / billing backend)
MISTERPILOT_VERIFY_URL=
USAGE_CHARGE_URL=
    