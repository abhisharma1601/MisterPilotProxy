# MisterPilot PII Filter — configuration template
# This file is read instead of .env (which is never loaded).
# PROXY_HMAC_KEY is auto-generated on first run if left blank.

PROXY_HMAC_KEY=

# Store backend: memory (default, no disk writes) | file | redis | database
PII_STORE_BACKEND=memory

# Uncomment to persist mappings across restarts (file backend):
# PII_STORE_BACKEND=file
# PII_STORE_PATH=./.pii_map.json

# Redis backend:
# PII_STORE_BACKEND=redis
# PII_REDIS_URL=redis://localhost:6379

PROXY_HMAC_KEY=eb31260937ca94a720ab202ac08c886575206461b638e2c65acd1c5ee46298e8
